<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--  HVAC Permission  -->
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <!--  EvBattery  -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- Car Info 혹시 hvac 자동 운용시 차량 cc에 맞는거 제공해줘야할 필요가 있어서 -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- AAOS에서 사용 -->
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- NaviHelper: 즐겨찾기/목적지 조회 (getBookmarkInfo 등), 경로 요청 (requestRoute)
         누락 시 SDK가 SecurityException을 던짐 — Protection level: Normal -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 기상 시퀀스: 성에 제거·공조·조명·창문·시트/핸들 열선·미러 열선 제어 (Pleos, 모두 normal) -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_MIRRORS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_MIRRORS" />
    <!-- 사이드미러 접기/펴기(VHAL MIRROR_FOLD): signature|privileged — 일반 설치로는 부여되지 않음.
         시스템 앱으로 탑재될 때를 위해 선언만 해 둠 (CarControl.unfoldMirrors가 권한 확인 후 시도) -->
    <uses-permission android:name="android.car.permission.CONTROL_CAR_MIRRORS" />
    <!-- 기상 알림 (Android 13+ 런타임 권한) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <application
        android:name=".GoodNightCampApp"
        android:allowBackup="true"
        android:appCategory="audio"
        android:icon="@mipmap/ic_goodnight_camp"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_goodnight_camp_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GoodnightCamp">
        <!-- CCP 미지원 선언 -->
        <meta-data
            android:name="com.hmg.rotary.ROTARY_SUPPORTED"
            android:value="false"/>
        <activity
            android:name=".activity.SetUpActivity"
            android:configChanges="orientation|screenSize|screenLayout"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activity.PlanActivity"
            android:configChanges="orientation|screenSize|screenLayout"
            android:exported="false" />

        <activity
            android:name=".activity.CampingActivity"
            android:configChanges="orientation|screenSize|screenLayout"
            android:exported="false" />

        <activity
            android:name=".activity.WakeActivity"
            android:configChanges="orientation|screenSize|screenLayout"
            android:exported="false" />

        <service
            android:name=".service.CarDataService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>