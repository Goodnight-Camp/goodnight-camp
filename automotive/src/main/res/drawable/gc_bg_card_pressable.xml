<?xml version="1.0" encoding="utf-8"?>
<!-- 누를 수 있는 카드 타일: 평소엔 카드, 누르면 한 단계 높은 면 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_high" />
            <corners android:radius="@dimen/gc_card_radius" />
            <stroke android:width="@dimen/gc_card_stroke" android:color="@color/border_card" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_basic" />
            <corners android:radius="@dimen/gc_card_radius" />
            <stroke android:width="@dimen/gc_card_stroke" android:color="@color/border_card" />
        </shape>
    </item>
</selector>
