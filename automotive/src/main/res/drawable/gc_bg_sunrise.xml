<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/sunrise_start" android:endColor="@color/sunrise_end" />
            <corners android:radius="@dimen/gc_sunrise_radius" />
        </shape>
    </item>
    <item android:gravity="bottom|center_horizontal" android:width="@dimen/gc_space_96" android:height="@dimen/gc_space_48" android:bottom="@dimen/gc_space_20">
        <shape android:shape="oval">
            <solid android:color="@color/sunrise_sun" />
        </shape>
    </item>
    <item android:gravity="bottom|fill_horizontal" android:height="@dimen/gc_space_4" android:bottom="@dimen/gc_space_28">
        <shape android:shape="rectangle">
            <solid android:color="#99FFFFFF" />
        </shape>
    </item>
</layer-list>
