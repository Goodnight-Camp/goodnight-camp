<?xml version="1.0" encoding="utf-8"?>
<!--
  공통 헤더: 로고(달) + 앱 이름 + 화면별 부제 / 오른쪽 위치·기어 알약
  (SaBu의 상단 현장 선택 드롭다운 자리를 "강원 양양 · P 정차 중"으로 옮긴 형태)
  부제는 화면 코드에서 gc_header_subtitle 에 넣습니다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/gc_header_back"
        style="@style/Widget.GC.IconButton"
        android:layout_marginEnd="@dimen/gc_space_8"
        android:contentDescription="@string/gc_action_back"
        android:src="@drawable/gc_ic_chevron_down"
        android:rotation="90"
        android:visibility="gone" />

    <ImageView
        style="@style/Widget.GC.IconBox.Night"
        android:importantForAccessibility="no"
        android:src="@drawable/gc_ic_moon" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gc_space_20"
        android:orientation="vertical">

        <TextView
            android:id="@+id/gc_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gc_app_name"
            android:textAppearance="@style/TextAppearance.GC.AppTitle" />

        <TextView
            android:id="@+id/gc_header_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gc_space_2"
            android:textAppearance="@style/TextAppearance.GC.Subtitle"
            tools:text="@string/gc_setup_subtitle" />
    </LinearLayout>

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/gc_context_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/gc_bg_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gc_space_28"
        android:paddingTop="@dimen/gc_space_16"
        android:paddingEnd="@dimen/gc_space_24"
        android:paddingBottom="@dimen/gc_space_16">

        <ImageView
            android:layout_width="@dimen/gc_icon_sm"
            android:layout_height="@dimen/gc_icon_sm"
            android:importantForAccessibility="no"
            android:src="@drawable/gc_ic_pin"
            app:tint="@color/text_tertiary" />

        <TextView
            android:id="@+id/gc_context_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gc_space_12"
            android:text="@string/gc_context_location"
            android:textAppearance="@style/TextAppearance.GC.LabelLg"
            android:textColor="@color/text_primary"
            android:textFontWeight="700" />

        <ImageView
            android:layout_width="@dimen/gc_icon_sm"
            android:layout_height="@dimen/gc_icon_sm"
            android:layout_marginStart="@dimen/gc_space_12"
            android:importantForAccessibility="no"
            android:src="@drawable/gc_ic_chevron_down"
            app:tint="@color/text_tertiary" />
    </LinearLayout>
</LinearLayout>
