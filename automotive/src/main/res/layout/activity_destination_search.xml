<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/gc_app_padding_h"
    android:paddingTop="@dimen/gc_app_padding_v">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/gc_space_24">

        <ImageButton
            android:id="@+id/gc_dest_back"
            style="@style/Widget.GC.IconButton"
            android:layout_marginEnd="@dimen/gc_space_20"
            android:src="@drawable/gc_ic_chevron_down"
            android:rotation="90"
            android:contentDescription="@string/gc_action_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/gc_setting_destination"
            android:textAppearance="@style/TextAppearance.GC.CardTitle" />

    </LinearLayout>

    <!-- Search input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/gc_button_height"
        android:background="@drawable/gc_bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/gc_space_24"
        android:layout_marginBottom="@dimen/gc_space_20">

        <ImageView
            android:layout_width="@dimen/gc_icon_sm"
            android:layout_height="@dimen/gc_icon_sm"
            android:importantForAccessibility="no"
            android:src="@drawable/gc_ic_pin"
            android:layout_marginEnd="@dimen/gc_space_16" />

        <EditText
            android:id="@+id/gc_dest_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/gc_asta_sans"
            android:hint="@string/gc_search_destination_hint"
            android:imeOptions="actionSearch|flagNoFullscreen"
            android:inputType="text"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.GC.RowValue"
            android:textColorHint="@color/text_quaternary" />

        <ProgressBar
            android:id="@+id/gc_dest_progress"
            android:layout_width="@dimen/gc_icon_sm"
            android:layout_height="@dimen/gc_icon_sm"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Results (search or Navi list) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Nominatim search results -->
            <LinearLayout
                android:id="@+id/gc_dest_search_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/gc_bg_card"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/gc_space_8"
                android:visibility="gone" />


        </LinearLayout>

    </ScrollView>

</LinearLayout>
