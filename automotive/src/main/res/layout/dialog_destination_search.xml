<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_marginHorizontal="@dimen/gc_app_padding_h"
    android:layout_height="wrap_content"
    android:background="@drawable/gc_bg_card"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/gc_card_padding_h"
    android:paddingVertical="@dimen/gc_card_padding_v">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/gc_setting_destination"
        android:textAppearance="@style/TextAppearance.GC.CardTitle"
        android:layout_marginBottom="@dimen/gc_space_20" />

    <!-- Search input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/gc_button_height"
        android:background="@drawable/gc_bg_button_basic"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/gc_space_24">

        <ImageView
            android:layout_width="@dimen/gc_icon_sm"
            android:layout_height="@dimen/gc_icon_sm"
            android:importantForAccessibility="no"
            android:src="@drawable/gc_ic_pin"
            android:layout_marginEnd="@dimen/gc_space_16" />

        <EditText
            android:id="@+id/gc_search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/gc_asta_sans"
            android:hint="@string/gc_search_destination_hint"
            android:imeOptions="actionSearch|flagNoFullscreen"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.GC.RowValue"
            android:textColorHint="@color/text_quaternary" />

        <ProgressBar
            android:id="@+id/gc_search_progress"
            android:layout_width="@dimen/gc_icon_sm"
            android:layout_height="@dimen/gc_icon_sm"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Results list -->
    <LinearLayout
        android:id="@+id/gc_search_results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/gc_divider"
        android:background="@color/divider_primary"
        android:layout_marginTop="@dimen/gc_space_24"
        android:layout_marginBottom="@dimen/gc_space_16" />

    <!-- Cancel button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/gc_search_cancel"
            style="@style/Widget.GC.Button"
            android:layout_width="wrap_content"
            android:text="@string/gc_action_cancel" />

    </LinearLayout>

</LinearLayout>
