    <color name="border_card">#2A2B2F</color>
    <color name="divider_primary">#1AFFFFFF</color>

    <!-- Text -->
    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#D6FFFFFF</color>
    <color name="text_tertiary">#A3FFFFFF</color>
    <color name="text_quaternary">#52FFFFFF</color>
