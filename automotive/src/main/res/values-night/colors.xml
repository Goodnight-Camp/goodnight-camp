<?xml version="1.0" encoding="utf-8"?>
<!--
  굿나잇 캠프 · Pleos Color (Dark)
  Figma 파일의 "Pleos Color / Dark" 컬렉션과 1:1로 대응합니다.
  시스템이 다크 모드일 때 values/colors.xml 대신 자동으로 쓰입니다.
-->
