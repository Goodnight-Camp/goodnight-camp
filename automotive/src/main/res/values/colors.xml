<?xml version="1.0" encoding="utf-8"?>
<!--
  굿나잇 캠프 · 아침 팔레트 (Morning)
  디자인 기준: Goodnight-Camp/.github 레포의 DESIGN.md (레퍼런스 hyundai — 네이비·청록 톤)
  앱 기본은 밤 테마이고, 기상 화면(WakeActivity)만 이 밝은 팔레트로 연다.
  토큰 이름은 values-night/colors.xml(밤 팔레트)과 같다. 알파는 #AARRGGBB.
-->
<resources>
    <!-- Background / Surface -->
    <color name="background_primary">#F4F6F9</color>
    <color name="surface_basic">#FFFFFF</color>
    <color name="surface_high">#E9EDF2</color>
    <color name="border_card">#DDE3EA</color>
    <color name="divider_primary">#1A0A1B30</color>

    <!-- Text — 현대 네이비 계열 잉크 -->
    <color name="text_primary">#0A1B30</color>
    <color name="text_secondary">#D60A1B30</color>
    <color name="text_tertiary">#A30A1B30</color>
    <color name="text_quaternary">#7A0A1B30</color>
    <color name="text_on_filled">#FFFFFF</color>

    <!-- Button — 주 동작은 현대 네이비 -->
    <color name="button_basic_enabled">#0D0A1B30</color>
    <color name="button_basic_pressed">#1A0A1B30</color>
    <color name="button_basic_disabled">#080A1B30</color>
    <color name="button_filled_enabled">#002C5F</color>
    <color name="button_filled_pressed">#001F44</color>

    <!-- Informative (밝은 면에서 4.5:1 이상이 되도록 진하게) -->
    <color name="informative_active">#007A48</color>
    <color name="informative_positive">#0057E0</color>
    <color name="informative_negative">#C42E12</color>
    <color name="informative_night">#006B8F</color>
    <color name="regulation_orange">#A85A00</color>

    <!-- Tint (칩·아이콘 박스·단계) -->
    <color name="tint_negative">#1AC42E12</color>
    <color name="tint_active">#1A007A48</color>
    <color name="tint_night">#1A006B8F</color>
    <color name="tint_orange">#1FE68A00</color>

    <!-- Switch -->
    <color name="switch_on">#002C5F</color>
    <color name="switch_off">#4D0A1B30</color>
    <color name="switch_knob">#FFFFFF</color>

    <!-- 수면 중 화면: 어느 테마에서도 어둡게 -->
    <color name="sleep_background">#05080F</color>
    <color name="sleep_text">#66FFFFFF</color>
    <color name="sleep_text_dim">#33FFFFFF</color>

    <!-- 기상 화면 일출 그래픽 -->
    <color name="sunrise_start">#C9D8F0</color>
    <color name="sunrise_end">#FFD9A8</color>
    <color name="sunrise_sun">#FFB547</color>

    <!-- 목적지 검색 목록 -->
    <color name="gnc_text">#0A1B30</color>
    <color name="gnc_text_dim">#D60A1B30</color>
    <color name="gnc_text_sub">#A30A1B30</color>
    <color name="gnc_line">#1A0A1B30</color>
    <color name="gnc_accent">#006B8F</color>
    <color name="gnc_border">#DDE3EA</color>
    <color name="gnc_bg">#FFFFFF</color>
    <color name="gnc_surface">#F4F6F9</color>
</resources>
